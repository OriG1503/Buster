# Copy to app/server/.env and fill in values
# Used by both local development and docker-compose

# Required
DATABASE_URL=postgresql://user:password@your-neon-host/buster?sslmode=require

# Set automatically by docker-compose; override here only for local dev
PARSER_URL=http://localhost:8000

# Optional — S3 file persistence (upload skipped if S3_BUCKET is empty)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
